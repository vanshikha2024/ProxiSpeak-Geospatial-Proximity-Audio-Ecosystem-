PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/virtual_office?retryWrites=true&w=majority
# Comma-separated exact frontend origins; do not include trailing slashes
CLIENT_ORIGIN=http://localhost:5173
DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=1
